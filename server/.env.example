# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/velozity_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (At least 32 characters in production)
JWT_ACCESS_SECRET="velozity_access_super_secret_jwt_key_2026_at_least_32_characters"
JWT_REFRESH_SECRET="velozity_refresh_super_secret_jwt_key_2026_at_least_32_characters"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Overdue Background Job Interval (Cron format or milliseconds)
OVERDUE_JOB_INTERVAL_MINUTES=5
